{
  "name": "nextmap",
  "version": "0.1.0",
  "private": true,
  "description": "3D alpine map for Tyrol: tiris laser-scan terrain, summer/winter imagery and crawled hiking and ski-touring routes",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --sourcemap --format=esm --target=es2022 --outfile=public/app.js",
    "watch": "esbuild src/main.js --bundle --sourcemap --format=esm --target=es2022 --outfile=public/app.js --watch=forever",
    "start": "npm run build && node server/index.js",
    "dev": "npm run build && (npm run watch & node --watch-path=server server/index.js)",
    "crawl": "node server/crawler/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "geotiff": "^2.1.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
